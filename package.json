{
  "name": "google-drive-connector",
  "version": "0.6.0",
  "description": "Builders League Google Drive connector — portable core with thin MCP adapter and OpenAPI",
  "type": "module",
  "main": "./dist/connector.js",
  "types": "./dist/connector.d.ts",
  "exports": {
    ".": {
      "types": "./dist/connector.d.ts",
      "import": "./dist/connector.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/mcp/http-entry.js",
    "render:build": "npm ci --include=dev && npm run build",
    "start:mcp-http": "tsx src/mcp/http-entry.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:openapi": "tsx --test tests/openapi.test.ts",
    "test:mcp": "tsx --test tests/mcp-adapter.test.ts",
    "test:mcp-http": "tsx --test tests/mcp-http.test.ts",
    "test:connection": "tsx scripts/test-connection.ts",
    "test:search": "tsx scripts/test-search-files.ts",
    "test:list-folder": "tsx scripts/test-list-folder.ts",
    "test:read": "tsx scripts/test-read-or-export-file.ts",
    "test:upload": "tsx scripts/test-upload-file.ts",
    "test:share": "tsx scripts/test-share-file.ts",
    "validate:remote-mcp": "tsx scripts/validate-remote-mcp.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "google-drive",
    "connector",
    "oauth",
    "mcp",
    "openapi",
    "builders-league"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@types/body-parser": "^1.19.6",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/node": "^22.13.10",
    "@types/qs": "^6.15.1",
    "@types/serve-static": "^2.2.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "yaml": "^2.9.0"
  }
}
