# Google Cloud OAuth client (Desktop or Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# User-delegated refresh token from the OAuth authorization-code flow.
# Never commit the real value. Obtain it once for the sandbox test account.
GOOGLE_REFRESH_TOKEN=

# Optional: override token endpoint (defaults to Google's standard endpoint)
# GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
